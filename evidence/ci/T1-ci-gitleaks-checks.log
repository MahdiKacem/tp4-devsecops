2026-11-26T13:27:56.6928754Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_4.__run_3]
2026-11-26T13:27:56.7960598Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:56.7961517Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:56.7962054Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:27:56.7962510Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:27:56.7962854Z 
2026-11-26T13:27:56.7963168Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:27:56.7963549Z #
2026-11-26T13:27:56.7963736Z # Inputs
2026-11-26T13:27:56.7963945Z # Environment Variables
2026-11-26T13:27:56.7964185Z # Config File
2026-11-26T13:27:56.7964389Z # Defaults
2026-11-26T13:27:56.7964601Z #
2026-11-26T13:27:56.7964964Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:27:56.7965750Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:27:56.7966310Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:27:56.7966901Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:27:56.7967386Z # match the configuration priority that is documented.
2026-11-26T13:27:56.7967879Z set_env_var_if_provided() {
2026-11-26T13:27:56.7968124Z   local var_name="$1"
2026-11-26T13:27:56.7968443Z   local input_value="$2"
2026-11-26T13:27:56.7968747Z   local default_value="$3"
2026-11-26T13:27:56.7968978Z 
2026-11-26T13:27:56.7969381Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:27:56.7969792Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:27:56.7970238Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:27:56.7970675Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:27:56.7970988Z   fi
2026-11-26T13:27:56.7971177Z }
2026-11-26T13:27:56.7971353Z 
2026-11-26T13:27:56.7971613Z # Set environment variables, handling those with default values
2026-11-26T13:27:56.7972112Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:27:56.7972604Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:27:56.7972967Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:27:56.7973386Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
2026-11-26T13:27:56.7973830Z set_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"
