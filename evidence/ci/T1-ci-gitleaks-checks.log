2026-11-26T13:27:47.3490313Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_3.__run_3]
2026-11-26T13:27:47.3638796Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:47.3639499Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:47.3640019Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:27:47.3640480Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:27:47.3640832Z 
2026-11-26T13:27:47.3641138Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:27:47.3641495Z #
2026-11-26T13:27:47.3641666Z # Inputs
2026-11-26T13:27:47.3641862Z # Environment Variables
2026-11-26T13:27:47.3642084Z # Config File
2026-11-26T13:27:47.3642283Z # Defaults
2026-11-26T13:27:47.3642458Z #
2026-11-26T13:27:47.3642794Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:27:47.3643322Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:27:47.3643866Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:27:47.3644444Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:27:47.3645181Z # match the configuration priority that is documented.
2026-11-26T13:27:47.3645600Z set_env_var_if_provided() {
2026-11-26T13:27:47.3645831Z   local var_name="$1"
2026-11-26T13:27:47.3646066Z   local input_value="$2"
2026-11-26T13:27:47.3646294Z   local default_value="$3"
2026-11-26T13:27:47.3646514Z 
2026-11-26T13:27:47.3646765Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:27:47.3647156Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:27:47.3647588Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:27:47.3648008Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:27:47.3648304Z   fi
2026-11-26T13:27:47.3648473Z }
2026-11-26T13:27:47.3648639Z 
2026-11-26T13:27:47.3648885Z # Set environment variables, handling those with default values
2026-11-26T13:27:47.3649352Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:27:47.3649786Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:27:47.3650130Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:27:47.3650526Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
2026-11-26T13:27:47.3650945Z set_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"
2026-11-26T13:27:47.3651409Z set_env_var_if_provided "TRIVY_SEVERITY" "$INPUT_SEVERITY" "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL"
