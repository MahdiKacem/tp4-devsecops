2026-11-26T13:27:26.4472158Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_3.__run_3]
2026-11-26T13:27:26.5110073Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:26.5111021Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:26.5111574Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:27:26.5112050Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:27:26.5112390Z 
2026-11-26T13:27:26.5112709Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:27:26.5113085Z #
2026-11-26T13:27:26.5113268Z # Inputs
2026-11-26T13:27:26.5113465Z # Environment Variables
2026-11-26T13:27:26.5113713Z # Config File
2026-11-26T13:27:26.5113921Z # Defaults
2026-11-26T13:27:26.5114117Z #
2026-11-26T13:27:26.5114463Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:27:26.5115003Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:27:26.5115541Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:27:26.5116132Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:27:26.5116613Z # match the configuration priority that is documented.
2026-11-26T13:27:26.5116916Z set_env_var_if_provided() {
2026-11-26T13:27:26.5117168Z   local var_name="$1"
2026-11-26T13:27:26.5117406Z   local input_value="$2"
2026-11-26T13:27:26.5117836Z   local default_value="$3"
2026-11-26T13:27:26.5118071Z 
2026-11-26T13:27:26.5118344Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:27:26.5118747Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:27:26.5119190Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:27:26.5119625Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:27:26.5119926Z   fi
2026-11-26T13:27:26.5120109Z }
2026-11-26T13:27:26.5120282Z 
2026-11-26T13:27:26.5120733Z # Set environment variables, handling those with default values
2026-11-26T13:27:26.5121210Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:27:26.5121657Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:27:26.5122020Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:27:26.5122426Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
2026-11-26T13:27:26.5122864Z set_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"
