2026-11-26T13:27:19.7354781Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action.__run_3]
2026-11-26T13:27:19.7405550Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:19.7406315Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:19.7406927Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:27:19.7407370Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:27:19.7407691Z 
2026-11-26T13:27:19.7407997Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:27:19.7408346Z #
2026-11-26T13:27:19.7408523Z # Inputs
2026-11-26T13:27:19.7408726Z # Environment Variables
2026-11-26T13:27:19.7408957Z # Config File
2026-11-26T13:27:19.7409329Z # Defaults
2026-11-26T13:27:19.7409533Z #
2026-11-26T13:27:19.7409885Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:27:19.7410619Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:27:19.7411157Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:27:19.7411743Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:27:19.7412229Z # match the configuration priority that is documented.
2026-11-26T13:27:19.7412525Z set_env_var_if_provided() {
2026-11-26T13:27:19.7412770Z   local var_name="$1"
2026-11-26T13:27:19.7412991Z   local input_value="$2"
2026-11-26T13:27:19.7413233Z   local default_value="$3"
2026-11-26T13:27:19.7413446Z 
2026-11-26T13:27:19.7413895Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:27:19.7414284Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:27:19.7414714Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:27:19.7415142Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:27:19.7415434Z   fi
2026-11-26T13:27:19.7415607Z }
2026-11-26T13:27:19.7415773Z 
2026-11-26T13:27:19.7416021Z # Set environment variables, handling those with default values
2026-11-26T13:27:19.7416484Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:27:19.7416924Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:27:19.7417391Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:27:19.7417804Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
2026-11-26T13:27:19.7418226Z set_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"
2026-11-26T13:27:19.7418697Z set_env_var_if_provided "TRIVY_SEVERITY" "$INPUT_SEVERITY" "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL"
2026-11-26T13:27:19.7419140Z set_env_var_if_provided "TRIVY_FORMAT" "$INPUT_FORMAT" "table"
2026-11-26T13:27:19.7419490Z set_env_var_if_provided "TRIVY_TEMPLATE" "$INPUT_TEMPLATE" ""
2026-11-26T13:27:19.7419840Z set_env_var_if_provided "TRIVY_OUTPUT" "$INPUT_OUTPUT" ""
