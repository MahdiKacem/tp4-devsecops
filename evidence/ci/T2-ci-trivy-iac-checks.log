2026-11-26T13:27:32.5650241Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_4.__run_3]
2026-11-26T13:27:32.5994171Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:32.5994928Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:27:32.5995660Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:27:32.5996144Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:27:32.5996504Z 
2026-11-26T13:27:32.5996839Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:27:32.5997221Z #
2026-11-26T13:27:32.5997425Z # Inputs
2026-11-26T13:27:32.5997664Z # Environment Variables
2026-11-26T13:27:32.5997910Z # Config File
2026-11-26T13:27:32.5998128Z # Defaults
2026-11-26T13:27:32.5998329Z #
2026-11-26T13:27:32.5998696Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:27:32.5999264Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:27:32.5999822Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:27:32.6000625Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:27:32.6001160Z # match the configuration priority that is documented.
2026-11-26T13:27:32.6001478Z set_env_var_if_provided() {
2026-11-26T13:27:32.6001734Z   local var_name="$1"
2026-11-26T13:27:32.6002134Z   local input_value="$2"
2026-11-26T13:27:32.6002382Z   local default_value="$3"
2026-11-26T13:27:32.6002619Z 
2026-11-26T13:27:32.6002900Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:27:32.6003310Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:27:32.6003765Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:27:32.6004232Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:27:32.6004550Z   fi
2026-11-26T13:27:32.6004744Z }
