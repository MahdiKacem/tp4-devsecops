2026-11-26T13:23:19.7985706Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_2.__run_3]
2026-11-26T13:23:19.8859355Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:23:19.8861022Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:23:19.8862323Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:23:19.8863371Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:23:19.8864319Z 
2026-11-26T13:23:19.8865048Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:23:19.8865947Z #
2026-11-26T13:23:19.8866366Z # Inputs
2026-11-26T13:23:19.8866845Z # Environment Variables
2026-11-26T13:23:19.8867349Z # Config File
2026-11-26T13:23:19.8867799Z # Defaults
2026-11-26T13:23:19.8868247Z #
2026-11-26T13:23:19.8869113Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:23:19.8870563Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:23:19.8871943Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:23:19.8873473Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:23:19.8874979Z # match the configuration priority that is documented.
2026-11-26T13:23:19.8875690Z set_env_var_if_provided() {
2026-11-26T13:23:19.8876171Z   local var_name="$1"
2026-11-26T13:23:19.8876795Z   local input_value="$2"
2026-11-26T13:23:19.8877146Z   local default_value="$3"
2026-11-26T13:23:19.8877467Z 
2026-11-26T13:23:19.8877843Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
