2026-11-26T13:23:27.6087103Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_3.__run_3]
2026-11-26T13:23:27.6918741Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:23:27.6919791Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:23:27.6920656Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:23:27.6921319Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:23:27.6921809Z 
2026-11-26T13:23:27.6922262Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:23:27.6922801Z #
2026-11-26T13:23:27.6923080Z # Inputs
2026-11-26T13:23:27.6923379Z # Environment Variables
2026-11-26T13:23:27.6923730Z # Config File
2026-11-26T13:23:27.6924029Z # Defaults
2026-11-26T13:23:27.6924560Z #
2026-11-26T13:23:27.6925086Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:23:27.6925887Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:23:27.6926687Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:23:27.6927759Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:23:27.6928556Z # match the configuration priority that is documented.
2026-11-26T13:23:27.6929005Z set_env_var_if_provided() {
2026-11-26T13:23:27.6929362Z   local var_name="$1"
2026-11-26T13:23:27.6929818Z   local input_value="$2"
2026-11-26T13:23:27.6930175Z   local default_value="$3"
2026-11-26T13:23:27.6930510Z 
2026-11-26T13:23:27.6930897Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:23:27.6931502Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:23:27.6932156Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:23:27.6932820Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:23:27.6933271Z   fi
2026-11-26T13:23:27.6933533Z }
2026-11-26T13:23:27.6933784Z 
2026-11-26T13:23:27.6934342Z # Set environment variables, handling those with default values
2026-11-26T13:23:27.6935077Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:23:27.6935787Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:23:27.6936328Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
