2026-11-26T13:22:57.1448131Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action.__run_3]
2026-11-26T13:22:57.1857934Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:22:57.1859554Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:22:57.1860738Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:22:57.1861448Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:22:57.1862163Z 
2026-11-26T13:22:57.1862823Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:22:57.1863622Z #
2026-11-26T13:22:57.1863971Z # Inputs
2026-11-26T13:22:57.1864490Z # Environment Variables
2026-11-26T13:22:57.1864958Z # Config File
2026-11-26T13:22:57.1865373Z # Defaults
2026-11-26T13:22:57.1865744Z #
2026-11-26T13:22:57.1866456Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:22:57.1867566Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:22:57.1868426Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:22:57.1869291Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:22:57.1869870Z # match the configuration priority that is documented.
2026-11-26T13:22:57.1870212Z set_env_var_if_provided() {
2026-11-26T13:22:57.1870484Z   local var_name="$1"
2026-11-26T13:22:57.1870756Z   local input_value="$2"
2026-11-26T13:22:57.1871031Z   local default_value="$3"
2026-11-26T13:22:57.1871516Z 
2026-11-26T13:22:57.1871824Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:22:57.1872311Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:22:57.1872846Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:22:57.1873365Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:22:57.1873737Z   fi
2026-11-26T13:22:57.1873944Z }
2026-11-26T13:22:57.1874280Z 
2026-11-26T13:22:57.1874585Z # Set environment variables, handling those with default values
2026-11-26T13:22:57.1875162Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:22:57.1875712Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:22:57.1876141Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:22:57.1876739Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
2026-11-26T13:22:57.1877253Z set_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"
2026-11-26T13:22:57.1877834Z set_env_var_if_provided "TRIVY_SEVERITY" "$INPUT_SEVERITY" "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL"
2026-11-26T13:22:57.1878377Z set_env_var_if_provided "TRIVY_FORMAT" "$INPUT_FORMAT" "table"
2026-11-26T13:22:57.1878814Z set_env_var_if_provided "TRIVY_TEMPLATE" "$INPUT_TEMPLATE" ""
2026-11-26T13:22:57.1879238Z set_env_var_if_provided "TRIVY_OUTPUT" "$INPUT_OUTPUT" ""
