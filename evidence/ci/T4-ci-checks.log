2026-11-26T13:23:34.7991172Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_4.__run_3]
2026-11-26T13:23:34.8005952Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:23:34.8006843Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:23:34.8007521Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:23:34.8008093Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:23:34.8008527Z 
2026-11-26T13:23:34.8008923Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:23:34.8009399Z #
2026-11-26T13:23:34.8009628Z # Inputs
2026-11-26T13:23:34.8009886Z # Environment Variables
2026-11-26T13:23:34.8010195Z # Config File
2026-11-26T13:23:34.8010454Z # Defaults
2026-11-26T13:23:34.8010700Z #
2026-11-26T13:23:34.8011149Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:23:34.8011846Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:23:34.8012549Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:23:34.8013296Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:23:34.8013921Z # match the configuration priority that is documented.
2026-11-26T13:23:34.8014776Z set_env_var_if_provided() {
2026-11-26T13:23:34.8015087Z   local var_name="$1"
2026-11-26T13:23:34.8015399Z   local input_value="$2"
2026-11-26T13:23:34.8015704Z   local default_value="$3"
2026-11-26T13:23:34.8015997Z 
2026-11-26T13:23:34.8016338Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:23:34.8016965Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:23:34.8017530Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:23:34.8018081Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:23:34.8018507Z   fi
2026-11-26T13:23:34.8018752Z }
2026-11-26T13:23:34.8018972Z 
2026-11-26T13:23:34.8019299Z # Set environment variables, handling those with default values
2026-11-26T13:23:34.8019942Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:23:34.8020528Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:23:34.8021001Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:23:34.8021526Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
2026-11-26T13:23:34.8022084Z set_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"
2026-11-26T13:23:34.8022716Z set_env_var_if_provided "TRIVY_SEVERITY" "$INPUT_SEVERITY" "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL"
