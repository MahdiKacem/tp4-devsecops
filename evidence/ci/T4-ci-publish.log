2026-11-26T13:24:16.2841531Z bootstrap_linux_arm64_sha='56a16480bdd56ec789abaa65924402f6b92c0041f06885995853c05567b76f34'
2026-11-26T13:24:16.2842113Z bootstrap_darwin_amd64_sha='f1ed2787cc9648fd3c644fcb279e43f3f55da63b788d69a527aa14ad97ffdca1'
2026-11-26T13:24:16.2842697Z bootstrap_darwin_arm64_sha='54047052cf46f40a5c3c95a510db276e164ba77e096aea1ca1b733f770359689'
2026-11-26T13:24:16.2843295Z bootstrap_windows_amd64_sha='049026dae3246d6ea8201512ec3efce3aab0c7f1d338d52e26c525dd02b418a0'
2026-11-26T13:24:16.2843743Z cosign_executable_name=cosign
2026-11-26T13:24:16.2844028Z 
2026-11-26T13:24:16.2844265Z trap "popd >/dev/null" EXIT
2026-11-26T13:24:16.2844537Z 
2026-11-26T13:24:16.2844757Z pushd $HOME/.cosign > /dev/null
2026-11-26T13:24:16.2845036Z 
2026-11-26T13:24:16.2845254Z case Linux in
2026-11-26T13:24:16.2845507Z   Linux|linux)
2026-11-26T13:24:16.2845755Z     case X64 in
2026-11-26T13:24:16.2845994Z       X64|amd64)
2026-11-26T13:24:16.2846285Z         bootstrap_filename='cosign-linux-amd64'
2026-11-26T13:24:16.2846644Z         bootstrap_sha=${bootstrap_linux_amd64_sha}
2026-11-26T13:24:16.2847008Z         desired_cosign_filename='cosign-linux-amd64'
2026-11-26T13:24:16.2847337Z         ;;
2026-11-26T13:24:16.2847569Z 
2026-11-26T13:24:16.2847776Z       ARM|arm)
2026-11-26T13:24:16.2848058Z         bootstrap_filename='cosign-linux-arm'
2026-11-26T13:24:16.2848514Z         bootstrap_sha=${bootstrap_linux_arm_sha}
2026-11-26T13:24:16.2848879Z         desired_cosign_filename='cosign-linux-arm'
2026-11-26T13:24:16.2849191Z         ;;
2026-11-26T13:24:16.2849426Z 
2026-11-26T13:24:16.2849636Z       ARM64|arm64)
2026-11-26T13:24:16.2849929Z         bootstrap_filename='cosign-linux-arm64'
2026-11-26T13:24:16.2850270Z         bootstrap_sha=${bootstrap_linux_arm64_sha}
2026-11-26T13:24:16.2850621Z         desired_cosign_filename='cosign-linux-arm64'
2026-11-26T13:24:16.2850927Z         ;;
2026-11-26T13:24:16.2851154Z 
2026-11-26T13:24:16.2851361Z       *)
2026-11-26T13:24:16.2851630Z         log_error "unsupported architecture X64"
2026-11-26T13:24:16.2851939Z         exit 1
2026-11-26T13:24:16.2852170Z         ;;
2026-11-26T13:24:16.2852392Z     esac
2026-11-26T13:24:16.2852606Z     ;;
2026-11-26T13:24:16.2852827Z 
2026-11-26T13:24:16.2853034Z   macOS|macos)
2026-11-26T13:24:16.2853280Z     case X64 in
2026-11-26T13:24:16.2853523Z       X64|amd64)
2026-11-26T13:24:16.2853796Z         bootstrap_filename='cosign-darwin-amd64'
2026-11-26T13:24:16.2854145Z         bootstrap_sha=${bootstrap_darwin_amd64_sha}
2026-11-26T13:24:16.2854509Z         desired_cosign_filename='cosign-darwin-amd64'
2026-11-26T13:24:16.2854821Z         ;;
2026-11-26T13:24:16.2855047Z 
2026-11-26T13:24:16.2855257Z       ARM64|arm64)
2026-11-26T13:24:16.2855535Z         bootstrap_filename='cosign-darwin-arm64'
2026-11-26T13:24:16.2855874Z         bootstrap_sha=${bootstrap_darwin_arm64_sha}
2026-11-26T13:24:16.2856374Z         desired_cosign_filename='cosign-darwin-arm64'
2026-11-26T13:24:16.2856692Z         ;;
2026-11-26T13:24:16.2856925Z 
2026-11-26T13:24:16.2857136Z       *)
2026-11-26T13:24:16.2857399Z         log_error "unsupported architecture X64"
2026-11-26T13:24:16.2857815Z         exit 1
2026-11-26T13:24:16.2858060Z         ;;
2026-11-26T13:24:16.2858287Z     esac
2026-11-26T13:24:16.2858603Z     ;;
2026-11-26T13:24:16.2858815Z 
2026-11-26T13:24:16.2859033Z   Windows|windows)
2026-11-26T13:24:16.2859285Z     case X64 in
2026-11-26T13:24:16.2859527Z       X64|amd64)
2026-11-26T13:24:16.2859819Z         bootstrap_filename='cosign-windows-amd64.exe'
2026-11-26T13:24:16.2860186Z         bootstrap_sha=${bootstrap_windows_amd64_sha}
2026-11-26T13:24:16.2871781Z         desired_cosign_filename='cosign-windows-amd64.exe'
2026-11-26T13:24:16.2872186Z         cosign_executable_name=cosign.exe
2026-11-26T13:24:16.2872498Z         ;;
2026-11-26T13:24:16.2872735Z       *)
2026-11-26T13:24:16.2873017Z         log_error "unsupported architecture X64"
2026-11-26T13:24:16.2873342Z         exit 1
2026-11-26T13:24:16.2873581Z         ;;
2026-11-26T13:24:16.2873812Z     esac
