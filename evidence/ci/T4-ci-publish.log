2026-11-26T13:24:16.2881748Z # If the bootstrap and specified `cosign` releases are the same, we're done.
2026-11-26T13:24:16.2882167Z if [[ v2.6.5 == ${bootstrap_version} ]]; then
2026-11-26T13:24:16.2882663Z   log_info "bootstrap version successfully verified and matches requested version so nothing else to do"
2026-11-26T13:24:16.2883114Z   exit 0
