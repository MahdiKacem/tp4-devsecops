2026-11-26T13:24:16.2874772Z     exit 1
2026-11-26T13:24:16.2874982Z     ;;
2026-11-26T13:24:16.2875185Z esac
2026-11-26T13:24:16.2875389Z 
2026-11-26T13:24:16.2875593Z SUDO=
2026-11-26T13:24:16.2875893Z if [[ "false" == "true" ]] && command -v sudo >/dev/null; then
2026-11-26T13:24:16.2876220Z   SUDO=sudo
2026-11-26T13:24:16.2876446Z fi
2026-11-26T13:24:16.2876654Z 
2026-11-26T13:24:16.2876922Z expected_bootstrap_version_digest=${bootstrap_sha}
2026-11-26T13:24:16.2877759Z log_info "Downloading bootstrap version '${bootstrap_version}' of cosign to verify version to be installed...\n      https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}"
2026-11-26T13:24:16.2878869Z $SUDO curl -fsL https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename} -o ${cosign_executable_name}
2026-11-26T13:24:16.2879485Z shaBootstrap=$(shaprog ${cosign_executable_name});
2026-11-26T13:24:16.2879901Z if [[ $shaBootstrap != ${expected_bootstrap_version_digest} ]]; then
2026-11-26T13:24:16.2880333Z   log_error "Unable to validate cosign version: 'v2.6.5'"
2026-11-26T13:24:16.2880663Z   exit 1
2026-11-26T13:24:16.2880889Z fi
2026-11-26T13:24:16.2881139Z $SUDO chmod +x ${cosign_executable_name}
