2026-11-26T13:24:16.2886005Z 
2026-11-26T13:24:16.2886227Z # Download custom cosign
2026-11-26T13:24:16.2886846Z log_info "Downloading platform-specific version 'v2.6.5' of cosign...\n      https://github.com/sigstore/cosign/releases/download/v2.6.5/${desired_cosign_filename}"
2026-11-26T13:24:16.2887783Z $SUDO curl -fsL https://github.com/sigstore/cosign/releases/download/v2.6.5/${desired_cosign_filename} -o cosign_v2.6.5
2026-11-26T13:24:16.2888297Z shaCustom=$(shaprog cosign_v2.6.5);
2026-11-26T13:24:16.2888707Z 
2026-11-26T13:24:16.2888946Z # same hash means it is the same release
2026-11-26T13:24:16.2889272Z if [[ $shaCustom != $shaBootstrap ]]; then
2026-11-26T13:24:16.2889942Z   log_info "Downloading detached signature for platform-specific 'v2.6.5' of cosign...\n      https://github.com/sigstore/cosign/releases/download/v2.6.5/${desired_cosign_filename}.sig"
2026-11-26T13:24:16.2890802Z   $SUDO curl -fsLO https://github.com/sigstore/cosign/releases/download/v2.6.5/${desired_cosign_filename}.sig
2026-11-26T13:24:16.2891258Z 
2026-11-26T13:24:16.2891778Z   log_info "Downloading cosign public key 'v2.6.5' of cosign...\n    https://raw.githubusercontent.com/sigstore/cosign/v2.6.5/release/release-cosign.pub"
2026-11-26T13:24:16.2892554Z   RELEASE_COSIGN_PUB_KEY=https://raw.githubusercontent.com/sigstore/cosign/v2.6.5/release/release-cosign.pub
2026-11-26T13:24:16.2893195Z   RELEASE_COSIGN_PUB_KEY_SHA='f4cea466e5e887a45da5031757fa1d32655d83420639dc1758749b744179f126'
2026-11-26T13:24:16.2893601Z 
2026-11-26T13:24:16.2893871Z   log_info "Verifying public key matches expected value"
2026-11-26T13:24:16.2894262Z   $SUDO curl -fsL $RELEASE_COSIGN_PUB_KEY -o public.key
2026-11-26T13:24:16.2894614Z   sha_fetched_key=$(shaprog public.key)
2026-11-26T13:24:16.2894987Z   if [[ $sha_fetched_key != $RELEASE_COSIGN_PUB_KEY_SHA ]]; then
2026-11-26T13:24:16.2895425Z     log_error "Fetched public key does not match expected digest, exiting"
2026-11-26T13:24:16.2895790Z     exit 1
2026-11-26T13:24:16.2896012Z   fi
2026-11-26T13:24:16.2896223Z 
2026-11-26T13:24:16.2896561Z   log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T13:24:16.2897105Z   ./cosign verify-blob --key public.key --signature ${desired_cosign_filename}.sig cosign_v2.6.5
2026-11-26T13:24:16.2897508Z 
2026-11-26T13:24:16.2897718Z   $SUDO rm cosign
2026-11-26T13:24:16.2898021Z   $SUDO mv cosign_v2.6.5 ${cosign_executable_name}
2026-11-26T13:24:16.2898469Z   $SUDO chmod +x ${cosign_executable_name}
2026-11-26T13:24:16.2898794Z   log_info "Installation complete!"
2026-11-26T13:24:16.2899077Z fi
