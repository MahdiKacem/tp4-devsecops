2026-11-26T13:24:09.1436689Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action_2.__run_3]
2026-11-26T13:24:09.2462523Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:24:09.2463710Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:24:09.2464580Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:24:09.2465561Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:24:09.2466121Z 
2026-11-26T13:24:09.2466644Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:24:09.2467235Z #
2026-11-26T13:24:09.2467535Z # Inputs
2026-11-26T13:24:09.2467863Z # Environment Variables
2026-11-26T13:24:09.2468249Z # Config File
2026-11-26T13:24:09.2468698Z # Defaults
2026-11-26T13:24:09.2469016Z #
2026-11-26T13:24:09.2469611Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:24:09.2470725Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:24:09.2471630Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:24:09.2472613Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:24:09.2473400Z # match the configuration priority that is documented.
2026-11-26T13:24:09.2473895Z set_env_var_if_provided() {
2026-11-26T13:24:09.2474292Z   local var_name="$1"
2026-11-26T13:24:09.2474666Z   local input_value="$2"
2026-11-26T13:24:09.2475057Z   local default_value="$3"
2026-11-26T13:24:09.2475431Z 
2026-11-26T13:24:09.2475849Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:24:09.2476517Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:24:09.2477228Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:24:09.2477924Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:24:09.2478271Z   fi
2026-11-26T13:24:09.2478666Z }
2026-11-26T13:24:09.2478877Z 
2026-11-26T13:24:09.2479164Z # Set environment variables, handling those with default values
2026-11-26T13:24:09.2479677Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:24:09.2480155Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:24:09.2480553Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:24:09.2480995Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
