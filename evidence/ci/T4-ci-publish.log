2026-11-26T13:24:02.0825296Z ##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action.__run_3]
2026-11-26T13:24:02.0852547Z ##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:24:02.0853378Z # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
2026-11-26T13:24:02.0854246Z # This limitation affects how we handle default values and empty inputs.
2026-11-26T13:24:02.0854955Z # For more information, see: https://github.com/actions/runner/issues/924
2026-11-26T13:24:02.0855479Z 
2026-11-26T13:24:02.0855970Z # The following logic implements the configuration priority described in the README:
2026-11-26T13:24:02.0856537Z #
2026-11-26T13:24:02.0856844Z # Inputs
2026-11-26T13:24:02.0857162Z # Environment Variables
2026-11-26T13:24:02.0857538Z # Config File
2026-11-26T13:24:02.0857873Z # Defaults
2026-11-26T13:24:02.0858135Z #
2026-11-26T13:24:02.0858679Z # As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input
2026-11-26T13:24:02.0859265Z # if the caller doesn't provide them, thus if the input matches the default we don't set it as we
2026-11-26T13:24:02.0860009Z # can't tell the difference.  Plus if we did set it when it was the default value then it could potentially
2026-11-26T13:24:02.0861006Z # override an external environment variable, or something in the callers configuration file, which then wouldn't
2026-11-26T13:24:02.0861774Z # match the configuration priority that is documented.
2026-11-26T13:24:02.0862265Z set_env_var_if_provided() {
2026-11-26T13:24:02.0862644Z   local var_name="$1"
2026-11-26T13:24:02.0863004Z   local input_value="$2"
2026-11-26T13:24:02.0863372Z   local default_value="$3"
2026-11-26T13:24:02.0863903Z 
2026-11-26T13:24:02.0864322Z   if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then
2026-11-26T13:24:02.0864880Z     # If action was provided with explicit input by the caller set that
2026-11-26T13:24:02.0865354Z     # Use printf %q to safely escape special characters and prevent command injection
2026-11-26T13:24:02.0865818Z     printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt
2026-11-26T13:24:02.0866152Z   fi
2026-11-26T13:24:02.0866354Z }
2026-11-26T13:24:02.0866644Z 
2026-11-26T13:24:02.0867055Z # Set environment variables, handling those with default values
2026-11-26T13:24:02.0867808Z # cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables
2026-11-26T13:24:02.0868634Z set_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""
2026-11-26T13:24:02.0869210Z set_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""
2026-11-26T13:24:02.0869870Z set_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"
2026-11-26T13:24:02.0870565Z set_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"
2026-11-26T13:24:02.0871335Z set_env_var_if_provided "TRIVY_SEVERITY" "$INPUT_SEVERITY" "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL"
