2026-11-26T13:24:16.2822837Z #!/bin/bash
2026-11-26T13:24:16.2823092Z # cosign install script
2026-11-26T13:24:16.2823381Z shopt -s expand_aliases
2026-11-26T13:24:16.2823659Z if [ -z "$NO_COLOR" ]; then
2026-11-26T13:24:16.2823997Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T13:24:16.2824414Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T13:24:16.2824742Z else
2026-11-26T13:24:16.2824991Z   alias log_info="echo \"INFO:\""
2026-11-26T13:24:16.2825295Z   alias log_error="echo \"ERROR:\""
2026-11-26T13:24:16.2825588Z fi
2026-11-26T13:24:16.2825805Z set -e
2026-11-26T13:24:16.2826036Z 
2026-11-26T13:24:16.2826337Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T13:24:16.2826703Z if [[ "v2.6.5" != "main" ]]; then
2026-11-26T13:24:16.2827037Z   # Extract version without 'v' prefix for comparison
2026-11-26T13:24:16.2827357Z   version_num="v2.6.5"
2026-11-26T13:24:16.2827638Z   version_num="${version_num#v}"
2026-11-26T13:24:16.2827928Z 
2026-11-26T13:24:16.2828171Z   # Check if version is less than v2.0.0
2026-11-26T13:24:16.2828659Z   if [[ "$version_num" =~ ^[01]\. ]] || [[ "$version_num" =~ ^0\. ]]; then
2026-11-26T13:24:16.2829108Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T13:24:16.2829497Z     log_error "Requested version: v2.6.5"
2026-11-26T13:24:16.2829844Z     log_error "Please use cosign v2.4.0 or later."
2026-11-26T13:24:16.2830314Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T13:24:16.2830747Z     exit 1
2026-11-26T13:24:16.2830988Z   fi
2026-11-26T13:24:16.2831209Z fi
2026-11-26T13:24:16.2831417Z 
2026-11-26T13:24:16.2831653Z mkdir -p $HOME/.cosign
2026-11-26T13:24:16.2831916Z 
2026-11-26T13:24:16.2832143Z if [[ v2.6.5 == "main" ]]; then
2026-11-26T13:24:16.2832523Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T13:24:16.2832887Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T13:24:16.2833244Z   go install github.com/sigstore/cosign/v2/cmd/cosign@main
2026-11-26T13:24:16.2833616Z   ln -s $GOBIN/cosign $HOME/.cosign/cosign
2026-11-26T13:24:16.2833916Z   exit 0
2026-11-26T13:24:16.2834145Z fi
2026-11-26T13:24:16.2834360Z 
2026-11-26T13:24:16.2834569Z shaprog() {
2026-11-26T13:24:16.2834817Z   case Linux in
2026-11-26T13:24:16.2835074Z     Linux|linux)
2026-11-26T13:24:16.2835338Z       sha256sum $1 | cut -d' ' -f1
2026-11-26T13:24:16.2835621Z       ;;
2026-11-26T13:24:16.2835844Z     macOS|macos)
2026-11-26T13:24:16.2836116Z       shasum -a256 $1 | cut -d' ' -f1
2026-11-26T13:24:16.2836397Z       ;;
2026-11-26T13:24:16.2836622Z     Windows|windows)
2026-11-26T13:24:16.2837089Z       powershell -command "(Get-FileHash $1 -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T13:24:16.2837772Z       ;;
2026-11-26T13:24:16.2837996Z     *)
2026-11-26T13:24:16.2838248Z       log_error "unsupported OS Linux"
2026-11-26T13:24:16.2838655Z       exit 1
2026-11-26T13:24:16.2838890Z       ;;
2026-11-26T13:24:16.2839114Z   esac
2026-11-26T13:24:16.2839324Z }
2026-11-26T13:24:16.2839663Z 
2026-11-26T13:24:16.2839895Z bootstrap_version='v2.6.1'
2026-11-26T13:24:16.2840352Z bootstrap_linux_amd64_sha='064954c5d8c7e3b28188eee5b1727b31c411550bc5fefd41aa672d3c761d103a'
