2026-11-26T13:24:16.2883535Z 
2026-11-26T13:24:16.2883798Z semver='^v([0-9]+\.){0,2}(\*|[0-9]+)(-?r?c?)(\.[0-9]+)$'
2026-11-26T13:24:16.2884122Z if [[ v2.6.5 =~ $semver ]]; then
